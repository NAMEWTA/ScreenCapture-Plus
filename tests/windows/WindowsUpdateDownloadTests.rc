#include <winver.h>
// This is the test harness's own real PE version resource. It permits byte and
// PE-version testing of the legacy transport fallback without inventing a new
// product binary or changing the product's authoritative version.
1 VERSIONINFO
 FILEVERSION 0,0,5,0
 PRODUCTVERSION 0,0,5,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "huhucapture legacy update transport test harness\0"
   VALUE "FileVersion", "0.0.5.0\0"
   VALUE "ProductName", "Transport test fixture; not the product\0"
   VALUE "ProductVersion", "0.0.5.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
