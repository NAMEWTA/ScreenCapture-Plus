// Shared native version information. Values come from build/version.json.
VS_VERSION_INFO VERSIONINFO
FILEVERSION HUHU_VERSION_NUMBER
PRODUCTVERSION HUHU_VERSION_NUMBER
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "NAMEWTA"
            VALUE "FileDescription", "huhucapture"
            VALUE "FileVersion", HUHU_VERSION_TEXT
            VALUE "InternalName", "huhucapture.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 NAMEWTA"
            VALUE "OriginalFilename", "huhucapture.exe"
            VALUE "ProductName", "huhucapture"
            VALUE "ProductVersion", HUHU_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
