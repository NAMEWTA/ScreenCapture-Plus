#include <windows.h>
1 ICON "@PROJECT_SOURCE_DIR@/resources/logo.ico"
1 VERSIONINFO
FILEVERSION @HUHU_WINDOWS_VERSION@,0
PRODUCTVERSION @HUHU_WINDOWS_VERSION@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NAMEWTA\0"
            VALUE "FileDescription", "huhucapture\0"
            VALUE "FileVersion", "@HUHUCAPTURE_VERSION@.0\0"
            VALUE "InternalName", "huhucapture\0"
            VALUE "OriginalFilename", "huhucapture.exe\0"
            VALUE "ProductName", "huhucapture\0"
            VALUE "ProductVersion", "@HUHUCAPTURE_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
