<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Generated by scripts/build.ps1 from build/version.json. Do not edit. -->
  <PropertyGroup>
    <_HuhuVersionGenerated>true</_HuhuVersionGenerated>
    <_HuhuProductVersion>@PRODUCT_VERSION@</_HuhuProductVersion>
    <_HuhuVersionSourceSha256>@SOURCE_SHA256@</_HuhuVersionSourceSha256>
    <VersionMajor Condition="'$(VersionMajor)'==''">@VERSION_MAJOR@</VersionMajor>
    <VersionMinor Condition="'$(VersionMinor)'==''">@VERSION_MINOR@</VersionMinor>
    <VersionPatch Condition="'$(VersionPatch)'==''">@VERSION_PATCH@</VersionPatch>
    <VersionRevision Condition="'$(VersionRevision)'==''">0</VersionRevision>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ResourceCompile>
      <PreprocessorDefinitions>HUHU_VERSION_MAJOR=$(VersionMajor);HUHU_VERSION_MINOR=$(VersionMinor);HUHU_VERSION_PATCH=$(VersionPatch);HUHU_VERSION_REVISION=$(VersionRevision);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>
