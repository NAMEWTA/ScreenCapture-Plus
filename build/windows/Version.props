<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The retained product consumes generated metadata from build/version.json. -->
  <Import Project="$(ArtifactsRoot)generated\Version.props" Condition="Exists('$(ArtifactsRoot)generated\Version.props')" />
  <Target Name="RequireGeneratedHuhuVersion" BeforeTargets="PrepareForBuild;ResourceCompile">
    <Error Condition="'$(_HuhuVersionGenerated)'!='true'" Text="Generate version metadata with scripts/build.ps1 before using this retained Windows project." />
    <GetFileHash Files="$(RepoRoot)build\version.json" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HuhuVersionSourceHash" />
    </GetFileHash>
    <Error Condition="'%(_HuhuVersionSourceHash.FileHash)'!='$(_HuhuVersionSourceSha256)'" Text="build/version.json changed after metadata generation; rerun scripts/build.ps1." />
    <Error Condition="'$(VersionMajor).$(VersionMinor).$(VersionPatch)'!='$(_HuhuProductVersion)' or '$(VersionRevision)'!='0'" Text="Build version overrides must match build/version.json with revision zero." />
  </Target>
</Project>
