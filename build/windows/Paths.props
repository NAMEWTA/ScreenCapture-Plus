<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepoRoot>
    <DependencyRoot>$(RepoRoot).deps\</DependencyRoot>
    <LingRoot>$(DependencyRoot)ling\</LingRoot>
    <GifskiRoot>$(DependencyRoot)gifski\</GifskiRoot>
    <ArtifactsRoot>$(RepoRoot)artifacts\</ArtifactsRoot>
    <GifskiLibrary>$(ArtifactsRoot)cargo\x86_64-pc-windows-msvc\release\gifski.lib</GifskiLibrary>
  </PropertyGroup>
</Project>
