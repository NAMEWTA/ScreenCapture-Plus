# One product version is consumed by CMake, the retained Windows build and
# packaging. Changing a build parameter must not relabel different source.
get_filename_component(HUHUCAPTURE_VERSION_FILE "${CMAKE_CURRENT_LIST_DIR}/../version.json" ABSOLUTE)
file(SIZE "${HUHUCAPTURE_VERSION_FILE}" version_file_size)
if(version_file_size GREATER 4096)
    message(FATAL_ERROR "build/version.json exceeds its metadata budget")
endif()
file(READ "${HUHUCAPTURE_VERSION_FILE}" version_document)
string(JSON version_schema GET "${version_document}" schemaVersion)
string(JSON version_schema_type TYPE "${version_document}" schemaVersion)
string(JSON version_value_type TYPE "${version_document}" version)
string(JSON version_member_count LENGTH "${version_document}")
if(NOT version_schema STREQUAL "1" OR NOT version_schema_type STREQUAL "NUMBER"
    OR NOT version_value_type STREQUAL "STRING" OR NOT version_member_count EQUAL 2)
    message(FATAL_ERROR "build/version.json must use schemaVersion 1 and a version string")
endif()
string(JSON HUHUCAPTURE_VERSION GET "${version_document}" version)
if(NOT HUHUCAPTURE_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "build/version.json must contain one canonical MAJOR.MINOR.PATCH value")
endif()
string(REPLACE "." ";" version_parts "${HUHUCAPTURE_VERSION}")
foreach(part IN LISTS version_parts)
    string(LENGTH "${part}" part_length)
    if(part_length GREATER 5 OR part GREATER 65535)
        message(FATAL_ERROR "build/version.json components must fit Windows resource WORD values")
    endif()
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${HUHUCAPTURE_VERSION_FILE}")
