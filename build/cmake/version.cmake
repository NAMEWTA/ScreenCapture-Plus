# build/version.json is the sole hand-maintained product version. Generated
# compatibility files are checked, never silently repaired by a normal build.
get_filename_component(_huhu_version_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(HUHUCAPTURE_VERSION_FILE "${_huhu_version_root}/build/version.json")
set(_huhu_version_template "${_huhu_version_root}/build/windows/Version.props.in")
set(_huhu_version_props "${_huhu_version_root}/build/windows/Version.props")
set(_huhu_version_compatibility "${_huhu_version_root}/VERSION")
foreach(input IN ITEMS "${HUHUCAPTURE_VERSION_FILE}" "${_huhu_version_template}"
        "${_huhu_version_props}" "${_huhu_version_compatibility}")
    if(NOT EXISTS "${input}" OR IS_SYMLINK "${input}")
        message(FATAL_ERROR "Missing or linked version input: ${input}. Run python scripts/version_source.py --write")
    endif()
endforeach()
file(SIZE "${HUHUCAPTURE_VERSION_FILE}" _huhu_version_size)
if(_huhu_version_size GREATER 4096)
    message(FATAL_ERROR "build/version.json is oversized")
endif()
file(READ "${HUHUCAPTURE_VERSION_FILE}" _huhu_version_document)
string(JSON _huhu_version_type ERROR_VARIABLE _huhu_version_error TYPE "${_huhu_version_document}")
if(_huhu_version_error OR NOT _huhu_version_type STREQUAL "OBJECT")
    message(FATAL_ERROR "build/version.json must be a JSON object")
endif()
string(JSON _huhu_version_fields LENGTH "${_huhu_version_document}")
string(JSON _huhu_version_schema ERROR_VARIABLE _huhu_version_error GET "${_huhu_version_document}" schemaVersion)
if(_huhu_version_error OR NOT _huhu_version_schema STREQUAL "1" OR NOT _huhu_version_fields EQUAL 2)
    message(FATAL_ERROR "build/version.json requires schemaVersion 1 and one version string")
endif()
string(JSON _huhu_version_schema_type TYPE "${_huhu_version_document}" schemaVersion)
string(JSON _huhu_version_type ERROR_VARIABLE _huhu_version_error TYPE "${_huhu_version_document}" version)
if(_huhu_version_error OR NOT _huhu_version_type STREQUAL "STRING" OR NOT _huhu_version_schema_type STREQUAL "NUMBER")
    message(FATAL_ERROR "build/version.json requires numeric schemaVersion 1 and one version string")
endif()
string(JSON HUHUCAPTURE_VERSION GET "${_huhu_version_document}" version)
if(NOT HUHUCAPTURE_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "build/version.json requires one canonical MAJOR.MINOR.PATCH value")
endif()
string(REPLACE "." ";" _huhu_version_parts "${HUHUCAPTURE_VERSION}")
foreach(part IN LISTS _huhu_version_parts)
    string(LENGTH "${part}" part_length)
    if(part_length GREATER 5 OR part GREATER 65535)
        message(FATAL_ERROR "build/version.json components must fit Windows resource WORD values")
    endif()
endforeach()
set(HUHU_PRODUCT_VERSION "${HUHUCAPTURE_VERSION}")
list(GET _huhu_version_parts 0 HUHU_VERSION_MAJOR)
list(GET _huhu_version_parts 1 HUHU_VERSION_MINOR)
list(GET _huhu_version_parts 2 HUHU_VERSION_PATCH)
file(SHA256 "${HUHUCAPTURE_VERSION_FILE}" HUHU_VERSION_SOURCE_SHA256)
file(SHA256 "${_huhu_version_template}" HUHU_VERSION_TEMPLATE_SHA256)
file(READ "${_huhu_version_template}" _huhu_version_props_template)
string(CONFIGURE "${_huhu_version_props_template}" _huhu_version_expected_props @ONLY)
file(READ "${_huhu_version_props}" _huhu_version_actual_props)
file(READ "${_huhu_version_compatibility}" _huhu_version_actual_compatibility)
if(NOT _huhu_version_actual_props STREQUAL _huhu_version_expected_props OR
        NOT _huhu_version_actual_compatibility STREQUAL "${HUHUCAPTURE_VERSION}\n")
    message(FATAL_ERROR "Generated VERSION or Version.props is stale; run python scripts/version_source.py --write")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${HUHUCAPTURE_VERSION_FILE}"
    "${_huhu_version_template}" "${_huhu_version_props}" "${_huhu_version_compatibility}")
