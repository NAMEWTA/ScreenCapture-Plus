# Fixed-source inspection DLLs, using the actual matching-CRT build metadata.
# This does not replace the retained Windows capture / MF recorder.
set(HUHUCAPTURE_WINDOWS_VIDEO_METADATA
    "${PROJECT_SOURCE_DIR}/.deps/video-inspection-windows/build-info.json"
    CACHE FILEPATH "Actual FFmpeg Windows inspection build and integrity metadata")
file(READ "${HUHUCAPTURE_WINDOWS_VIDEO_METADATA}" video_metadata)
file(READ "${PROJECT_SOURCE_DIR}/build/dependencies.lock.json" dependency_lock)
string(JSON video_source GET "${video_metadata}" source)
string(JSON expected_source GET "${dependency_lock}" qtMigration softwareMedia ffmpeg commit)
string(JSON video_patches GET "${video_metadata}" patches)
string(JSON expected_patches GET "${dependency_lock}" qtMigration softwareMedia ffmpeg patches)
if(NOT video_source STREQUAL expected_source OR NOT video_patches STREQUAL expected_patches)
    message(FATAL_ERROR "Video inspection metadata does not match the fixed source and strict patches")
endif()

function(huhucapture_check_windows_video_configure configuration prefix crt)
    # build-windows-video-inspection.py records its complete argv, not only the
    # lock profile. The two leading paths and four trailing tool/CRT arguments
    # are script-owned; every profile argument between them must match exactly.
    string(JSON profile_count LENGTH "${dependency_lock}" qtMigration videoInspectionWindows configure)
    string(JSON actual_count LENGTH "${video_metadata}" configurations ${configuration} configure)
    math(EXPR expected_count "${profile_count} + 6")
    if(NOT actual_count EQUAL expected_count OR profile_count LESS 1)
        message(FATAL_ERROR "${configuration} inspection configure arguments do not match the locked profile")
    endif()
    math(EXPR profile_last "${profile_count} - 1")
    foreach(index RANGE ${profile_last})
        string(JSON expected GET "${dependency_lock}" qtMigration videoInspectionWindows configure ${index})
        math(EXPR actual_index "${index} + 2")
        string(JSON actual GET "${video_metadata}" configurations ${configuration} configure ${actual_index})
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "${configuration} inspection profile differs from the lock: ${actual}; expected ${expected}")
        endif()
    endforeach()
    string(JSON source_argument GET "${video_metadata}" configurations ${configuration} configure 0)
    string(JSON prefix_argument GET "${video_metadata}" configurations ${configuration} configure 1)
    if(NOT source_argument MATCHES "^/.+/configure$")
        message(FATAL_ERROR "${configuration} inspection configure must name the restored source through its absolute MSYS path")
    endif()
    # cygpath -u converts the recorded native prefix C:/... to /c/...; UNC
    # prefixes retain //server/share. Windows path comparison is insensitive to
    # case, but an unrelated output directory is not an accepted substitute.
    string(REPLACE "\\" "/" expected_prefix "${prefix}")
    if(expected_prefix MATCHES "^([A-Za-z]):/(.*)$")
        set(expected_prefix "/${CMAKE_MATCH_1}/${CMAKE_MATCH_2}")
    endif()
    string(TOLOWER "--prefix=${expected_prefix}" expected_prefix_argument)
    string(TOLOWER "${prefix_argument}" actual_prefix_argument)
    if(NOT actual_prefix_argument STREQUAL expected_prefix_argument)
        message(FATAL_ERROR "${configuration} inspection configure prefix differs from its recorded installation")
    endif()
    set(tail_offset 2)
    foreach(expected IN ITEMS "--extra-cflags=-${crt}" "--extra-cxxflags=-${crt}"
        "--extra-ldflags=-debug -opt:ref -opt:icf")
        math(EXPR actual_index "${profile_count} + ${tail_offset}")
        string(JSON actual GET "${video_metadata}" configurations ${configuration} configure ${actual_index})
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "${configuration} inspection script flags differ: ${actual}; expected ${expected}")
        endif()
        math(EXPR tail_offset "${tail_offset} + 1")
    endforeach()
    math(EXPR assembler_index "${profile_count} + 5")
    string(JSON assembler_argument GET "${video_metadata}" configurations ${configuration} configure ${assembler_index})
    if(NOT assembler_argument MATCHES "^--x86asmexe=/.+/nasm[.]exe$")
        message(FATAL_ERROR "${configuration} inspection assembler must name the restored native NASM through an absolute MSYS path")
    endif()
endfunction()

foreach(configuration IN ITEMS Debug Release)
    string(JSON prefix GET "${video_metadata}" configurations ${configuration} prefix)
    string(JSON actual_crt GET "${video_metadata}" configurations ${configuration} crt)
    string(JSON expected_crt GET "${dependency_lock}" qtMigration videoInspectionWindows configurations ${configuration})
    if(NOT actual_crt STREQUAL expected_crt OR NOT EXISTS "${prefix}/include/libavcodec/avcodec.h")
        message(FATAL_ERROR "Missing ${configuration} FFmpeg headers or matching CRT metadata")
    endif()
    huhucapture_check_windows_video_configure("${configuration}" "${prefix}" "${actual_crt}")
    file(TO_CMAKE_PATH "${prefix}" video_prefix_${configuration})
    string(JSON file_count LENGTH "${video_metadata}" configurations ${configuration} files)
    if(NOT file_count EQUAL 6)
        message(FATAL_ERROR "The inspection profile must have exactly three DLLs and three import libraries")
    endif()
    set(checked_files)
    math(EXPR last_file "${file_count} - 1")
    foreach(index RANGE ${last_file})
        string(JSON relative GET "${video_metadata}" configurations ${configuration} files ${index} path)
        file(TO_CMAKE_PATH "${relative}" relative)
        string(JSON expected_hash GET "${video_metadata}" configurations ${configuration} files ${index} sha256)
        if(NOT relative MATCHES "^bin/(avcodec-63\\.dll|avformat-63\\.dll|avutil-61\\.dll|avcodec\\.lib|avformat\\.lib|avutil\\.lib)$")
            message(FATAL_ERROR "Unexpected inspection binary: ${relative}")
        endif()
        if(relative IN_LIST checked_files OR NOT EXISTS "${prefix}/${relative}")
            message(FATAL_ERROR "Duplicate or missing inspection binary: ${relative}")
        endif()
        list(APPEND checked_files "${relative}")
        file(SHA256 "${prefix}/${relative}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Inspection binary changed after its build: ${relative}")
        endif()
    endforeach()
endforeach()

add_library(huhucapture_video_ffmpeg INTERFACE)
foreach(component IN ITEMS avcodec avformat avutil)
    if(component STREQUAL "avutil")
        set(major 61)
    else()
        set(major 63)
    endif()
    add_library(huhucapture_ffmpeg_${component} SHARED IMPORTED)
    set_target_properties(huhucapture_ffmpeg_${component} PROPERTIES
        IMPORTED_CONFIGURATIONS "Debug;Release"
        IMPORTED_IMPLIB_DEBUG "${video_prefix_Debug}/bin/${component}.lib"
        IMPORTED_LOCATION_DEBUG "${video_prefix_Debug}/bin/${component}-${major}.dll"
        IMPORTED_IMPLIB_RELEASE "${video_prefix_Release}/bin/${component}.lib"
        IMPORTED_LOCATION_RELEASE "${video_prefix_Release}/bin/${component}-${major}.dll"
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
        MAP_IMPORTED_CONFIG_MINSIZEREL Release
        INTERFACE_INCLUDE_DIRECTORIES "${video_prefix_Release}/include")
    target_link_libraries(huhucapture_video_ffmpeg INTERFACE huhucapture_ffmpeg_${component})
endforeach()
