+fn media() -> FileDto {
+    FileDto { id: "file".into(), file_name: "截图.png".into(), size: PNG.len() as u64,
+        file_type: "image/png".into(), sha256: Some(sha256_hex(PNG)), preview: None, metadata: None }
+}
