+    Started,
+    Verified(UploadVerification),
+    Rejected(UploadFailure),
+}
+
+struct Receiver {
+    handle: ServerHandle,
+    identity: SelfSignedCert,
+    sender: SelfSignedCert,
+    root: PathBuf,
+    observations: mpsc::Receiver<Observation>,
+    stop: Option<oneshot::Sender<()>>,
+    application: Option<tokio::task::JoinHandle<()>>,
