+
+/* huhucapture extension: the upstream sync API loses GError and blocks the
+ * caller. Keep the same protocol call with GIO's async/cancellable FD support. */
+static void
+pipewire_fd_free (gpointer data)
+{
+  int *fd = data;
+  if (*fd >= 0)
+    close (*fd);
+  g_free (fd);
+}
+
+static void
+pipewire_remote_returned (GObject *object, GAsyncResult *result, gpointer data)
+{
+  g_autoptr(GTask) task = data;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GUnixFDList) fd_list = NULL;
+  g_autoptr(GVariant) ret = NULL;
+  int index;
+  int fd;
+
+  ret = g_dbus_connection_call_with_unix_fd_list_finish (G_DBUS_CONNECTION (object),
+                                                        &fd_list, result, &error);
+  if (!ret)
+    {
+      g_task_return_error (task, g_steal_pointer (&error));
+      return;
+    }
+  g_variant_get (ret, "(h)", &index);
+  if (!fd_list)
+    {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                               "OpenPipeWireRemote returned no file descriptors");
+      return;
+    }
+  fd = g_unix_fd_list_get (fd_list, index, &error);
+  if (fd < 0)
+    g_task_return_error (task, g_steal_pointer (&error));
+  else
+    {
+      int *owned_fd = g_new (int, 1);
+      *owned_fd = fd;
+      g_task_return_pointer (task, owned_fd, pipewire_fd_free);
+    }
+}
+
+void
+xdp_session_open_pipewire_remote_async (XdpSession *session,
+                                        GCancellable *cancellable,
+                                        GAsyncReadyCallback callback,
+                                        gpointer data)
+{
+  GVariantBuilder options;
+  GTask *task;
+  g_return_if_fail (XDP_IS_SESSION (session));
+  task = g_task_new (session, cancellable, callback, data);
+  g_task_set_source_tag (task, xdp_session_open_pipewire_remote_async);
+  if (session->state != XDP_SESSION_ACTIVE)
+    {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CLOSED,
+                               "Screencast session is not active");
+      g_object_unref (task);
+      return;
+    }
+  g_variant_builder_init (&options, G_VARIANT_TYPE_VARDICT);
+  g_dbus_connection_call_with_unix_fd_list (session->portal->bus,
+                                            PORTAL_BUS_NAME, PORTAL_OBJECT_PATH,
+                                            "org.freedesktop.portal.ScreenCast",
+                                            "OpenPipeWireRemote",
+                                            g_variant_new ("(oa{sv})", session->id, &options),
+                                            G_VARIANT_TYPE ("(h)"), G_DBUS_CALL_FLAGS_NONE,
+                                            -1, NULL, cancellable,
+                                            pipewire_remote_returned, task);
+}
+
+int
+xdp_session_open_pipewire_remote_finish (XdpSession *session,
+                                         GAsyncResult *result,
+                                         GError **error)
+{
+  int *owned_fd;
+  int fd;
+  g_return_val_if_fail (g_task_is_valid (result, session), -1);
+  g_return_val_if_fail (g_task_get_source_tag (G_TASK (result)) == xdp_session_open_pipewire_remote_async, -1);
+  owned_fd = g_task_propagate_pointer (G_TASK (result), error);
+  if (!owned_fd)
+    return -1;
+  fd = *owned_fd;
+  g_free (owned_fd);
+  return fd;
 }
 
