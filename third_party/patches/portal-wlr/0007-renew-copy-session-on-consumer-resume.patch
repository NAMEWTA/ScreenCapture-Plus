+static bool ext_constraints_equal(const struct xdpw_buffer_constraints *left,
+		const struct xdpw_buffer_constraints *right) {
+	if (left->width != right->width || left->height != right->height ||
+			left->dmabuf_device != right->dmabuf_device ||
+			left->shm_formats.size != right->shm_formats.size ||
+			left->dmabuf_format_modifier_pairs.size != right->dmabuf_format_modifier_pairs.size) {
+		return false;
+	}
+	const struct xdpw_shm_format *lfmt, *rfmt;
+	wl_array_for_each(lfmt, &left->shm_formats) {
+		bool found = false;
+		wl_array_for_each(rfmt, &right->shm_formats) {
+			if (lfmt->fourcc == rfmt->fourcc && lfmt->stride == rfmt->stride) {
+				found = true;
+				break;
+			}
+		}
+		if (!found) {
+			return false;
+		}
+	}
+	const struct xdpw_format_modifier_pair *lpair, *rpair;
+	wl_array_for_each(lpair, &left->dmabuf_format_modifier_pairs) {
+		bool found = false;
+		wl_array_for_each(rpair, &right->dmabuf_format_modifier_pairs) {
+			if (lpair->fourcc == rpair->fourcc && lpair->modifier == rpair->modifier) {
+				found = true;
+				break;
+			}
+		}
+		if (!found) {
+			return false;
+		}
+	}
+	return true;
+}
+
 static void ext_session_done(void *data,
 		struct ext_image_copy_capture_session_v1 *ext_image_copy_capture_session_v1) {
 	struct xdpw_screencast_instance *cast = data;
+	if (cast->destroy_pending ||
+			ext_image_copy_capture_session_v1 != cast->ext_session.capture_session) {
+		return;
+	}
+	bool first_constraints = !cast->ext_session.constraints_ready;
 
 	logprint(TRACE, "ext: done handler");
 
@@ -131,16 +173,28 @@ static void ext_session_done(void *data,
 		fmt->stride = bpp * cast->pending_constraints.width;
 	}
 
+	bool reuse_constraints = first_constraints &&
+		ext_constraints_equal(&cast->current_constraints, &cast->pending_constraints);
 	if (xdpw_buffer_constraints_move(&cast->current_constraints, &cast->pending_constraints)) {
 		logprint(DEBUG, "ext: buffer constraints changed");
 		xdpw_gbm_device_update(cast);
-		pwr_update_stream_param(cast);
-		return;
+		// Re-advertising an identical first batch can pause the node again.
+		// Real constraint changes keep the existing renegotiation path.
+		if (!reuse_constraints) {
+			pwr_update_stream_param(cast);
+		}
 	}
 
-	if (!cast->initialized) {
+	if (cast->destroy_pending ||
+			ext_image_copy_capture_session_v1 != cast->ext_session.capture_session) {
 		return;
 	}
+	cast->ext_session.constraints_ready = true;
+	if (first_constraints && cast->initialized && cast->pwr_stream_state && cast->stream) {
+		// A resumed session is asynchronous. Its first process callback waits
+		// here before it can dequeue a buffer or send capture requests.
+		pw_stream_trigger_process(cast->stream);
+	}
 }
 
 static void ext_session_stopped(void *data,
@@ -254,6 +308,7 @@ static const struct ext_image_copy_capture_frame_v1_listener ext_frame_listener
 };
 
 static void ext_register_session_cb(struct xdpw_screencast_instance *cast) {
+	cast->ext_session.constraints_ready = false;
 	struct ext_image_capture_source_v1 *source = NULL;
 	switch (cast->target->type) {
 	case MONITOR:
@@ -274,13 +329,13 @@ static void ext_register_session_cb(struct xdpw_screencast_instance *cast) {
 			cast->target->with_cursor ? EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_OPTIONS_PAINT_CURSORS : 0);
 	ext_image_copy_capture_session_v1_add_listener(cast->ext_session.capture_session,
 			&ext_session_listener, cast);
+	// The capture session retains its source independently of this proxy.
+	ext_image_capture_source_v1_destroy(source);
 	logprint(TRACE, "ext: session callbacks registered");
 }
 
 static void ext_register_frame_cb(struct xdpw_screencast_instance *cast) {
-	if (!cast->ext_session.capture_session) {
-		ext_register_session_cb(cast);
-	}
+	assert(cast->ext_session.capture_session && cast->ext_session.constraints_ready);
 	cast->ext_session.frame = ext_image_copy_capture_session_v1_create_frame(
 			cast->ext_session.capture_session);
 	ext_image_copy_capture_frame_v1_add_listener(cast->ext_session.frame,
@@ -303,6 +358,10 @@ static void ext_register_frame_cb(struct xdpw_screencast_instance *cast) {
 
 void xdpw_ext_ic_frame_capture(struct xdpw_screencast_instance *cast) {
 	logprint(TRACE, "ext: start screencopy");
+	if (cast->destroy_pending || !cast->pwr_stream_state ||
+			!cast->ext_session.constraints_ready) {
+		return;
+	}
 	if (cast->current_frame.xdpw_buffer == NULL) {
 		logprint(ERROR, "ext: started frame without buffer");
 		return;
@@ -320,10 +379,24 @@ void xdpw_ext_ic_frame_cancel(struct xdpw_screencast_instance *cast) {
 
 void xdpw_ext_ic_session_close(struct xdpw_screencast_instance *cast) {
 	xdpw_ext_ic_frame_cancel(cast);
+	cast->ext_session.constraints_ready = false;
 	if (cast->ext_session.capture_session) {
 		ext_image_copy_capture_session_v1_destroy(cast->ext_session.capture_session);
 		cast->ext_session.capture_session = NULL;
 	}
+	// A partial constraint batch belongs only to the session just destroyed.
+	xdpw_buffer_constraints_finish(&cast->pending_constraints);
+	xdpw_buffer_constraints_init(&cast->pending_constraints);
+}
+
+bool xdpw_ext_ic_session_ready(struct xdpw_screencast_instance *cast) {
+	if (cast->destroy_pending) {
+		return false;
+	}
+	if (!cast->ext_session.capture_session) {
+		ext_register_session_cb(cast);
+	}
+	return cast->ext_session.constraints_ready;
 }
 
 int xdpw_ext_ic_session_init(struct xdpw_screencast_instance *cast) {
@@ -334,8 +407,11 @@ int xdpw_ext_ic_session_init(struct xdpw_screencast_instance *cast) {
 	}
 	ext_register_session_cb(cast);
 
-	// process at least one frame so that we know
-	// some of the metadata required for the pipewire
-	// remote state connected event
-	return wl_display_roundtrip(cast->ctx->state->wl_display);
+	// Initial stream creation also needs the complete first constraint batch.
+	if (wl_display_roundtrip(cast->ctx->state->wl_display) < 0 ||
+			!cast->ext_session.constraints_ready) {
+		xdpw_ext_ic_session_close(cast);
+		return -1;
+	}
+	return 0;
 }
