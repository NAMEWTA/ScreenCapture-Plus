+			// even when pause found no held buffer. Authorization and node stay.
+			xdpw_wlr_session_close(cast);
 		}
-		// fall through
+		break;
 	default:
 		cast->pwr_stream_state = false;
 		pwr_disarm_process_retry(cast);
@@ -661,6 +668,11 @@ static void pwr_handle_stream_on_process(void *data) {
 		return;
 	}
 
+	if (!xdpw_wlr_session_ready(cast)) {
+		// ext-image-copy capture is forbidden before its initial done event.
+		return;
+	}
+
 	xdpw_pwr_dequeue_buffer(cast);
 	if (!cast->current_frame.pw_buffer) {
 		logprint(WARN, "pipewire: unable to export buffer, dropping frame");
